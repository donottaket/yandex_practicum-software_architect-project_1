        <mxCell id="r14tTU0WGIqwB4w-ujAh-9" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;rounded=1;fillColor=#FF77BF;" parent="mNYROWRZp16-7qie_yd4-1" vertex="1">
